<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FieldKit.Core.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test methods don't need to thread xUnit's cancellation token through every call. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FieldKit.Core\FieldKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FieldKit.Core.Auth" />
    <Using Include="FieldKit.Core.Domain" />
    <Using Include="FieldKit.Core.Graph" />
  </ItemGroup>

  <!--
    Graph fixtures. Since the source went public (1.4.2) these are the Windows app's own copies,
    started from the iOS tests' FieldkitTests/Fixtures with neutral demo names, so this folder
    builds on its own in the public repo.
  -->
  <ItemGroup>
    <None Update="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
