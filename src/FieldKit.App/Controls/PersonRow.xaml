<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FieldKit.App.Controls.PersonRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <PersonPicture x:Name="Picture" Width="32" Height="32" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
        <StackPanel Grid.Column="1" Spacing="1">
            <TextBlock x:Name="NameText" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="UpnText" Style="{StaticResource CaptionSecondaryStyle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionSecondaryStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
