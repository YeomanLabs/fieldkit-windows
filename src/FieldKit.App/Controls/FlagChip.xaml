<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FieldKit.App.Controls.FlagChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <Border x:Name="Chip" Padding="10,5" BorderThickness="1" CornerRadius="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Severities">
                <VisualState x:Name="Info">
                    <VisualState.Setters>
                        <Setter Target="Chip.Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource SystemFillColorAttentionBrush}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}" />
                        <Setter Target="Icon.Glyph" Value="&#xE946;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Warning">
                    <VisualState.Setters>
                        <Setter Target="Chip.Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="Icon.Glyph" Value="&#xE7BA;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="Chip.Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="Icon.Glyph" Value="&#xEA39;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon x:Name="Icon" AutomationProperties.AccessibilityView="Raw" FontSize="14" />
            <TextBlock x:Name="Label" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" />
        </StackPanel>
    </Border>
</UserControl>
