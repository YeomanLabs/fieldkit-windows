<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FieldKit.App.Controls.DetailRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    IsTabStop="False">

    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="148" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Label, Mode=OneWay}" />
        <controls:ToneText Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}" Tone="{x:Bind Tone, Mode=OneWay}" />
    </Grid>
</UserControl>
