<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FieldKit.App.Controls.ToneText"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Tones">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Empty">
                    <VisualState.Setters>
                        <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Good">
                    <VisualState.Setters>
                        <Setter Target="Label.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Caution">
                    <VisualState.Setters>
                        <Setter Target="Label.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="Label.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBlock
            x:Name="Label"
            IsTextSelectionEnabled="{x:Bind IsSelectable, Mode=OneWay}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextAlignment="{x:Bind TextAlignment, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
