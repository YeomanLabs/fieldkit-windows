<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FieldKit.App.Views.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:domain="using:FieldKit.Core.Domain"
    xmlns:local="using:FieldKit.App.Views"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Invoked="Refresh_Invoked" Key="F5" />
    </Page.KeyboardAccelerators>

    <Grid MaxWidth="960" Padding="36,24,36,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="16">
            <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleStyle}" Text="Users" />
            <TextBox
                x:Name="SearchBox"
                AutomationProperties.Name="Search users"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                PlaceholderText="Name, email or UPN"
                Text="{x:Bind Users.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind Users.Heading, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <ProgressRing
                Grid.Column="1"
                Width="16"
                Height="16"
                IsActive="{x:Bind Users.IsBusy, Mode=OneWay}" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Refresh users"
                Command="{x:Bind Users.RefreshCommand}"
                ToolTipService.ToolTip="Refresh (F5)">
                <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <ListView
            x:Name="UserList"
            Grid.Row="2"
            Margin="-12,0"
            AutomationProperties.Name="Users"
            IsItemClickEnabled="True"
            ItemClick="User_ItemClick"
            ItemContainerStyle="{StaticResource NavigableListItemStyle}"
            ItemsSource="{x:Bind Users.Items}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="domain:DirectoryUser">
                    <controls:PersonRow Person="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <StackPanel Padding="12,8,12,24" Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Users.LoadMoreError, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:Ui.Visible(Users.HasLoadMoreError), Mode=OneWay}" />
                    <Button
                        Command="{x:Bind Users.LoadMoreCommand}"
                        Content="Load more users"
                        Visibility="{x:Bind local:Ui.Visible(Users.CanLoadMore), Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind local:Ui.Visible(Users.IsLoadingMore), Mode=OneWay}">
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind Users.IsLoadingMore, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Loading more…" />
                    </StackPanel>
                </StackPanel>
            </ListView.Footer>
        </ListView>

        <controls:ListStatus
            Grid.Row="2"
            VerticalAlignment="Top"
            NotFoundText="{x:Bind Users.NotFoundText, Mode=OneWay}"
            RetryCommand="{x:Bind Users.RefreshCommand}"
            State="{x:Bind Users.State, Mode=OneWay}"
            Subject="users" />
    </Grid>
</Page>
