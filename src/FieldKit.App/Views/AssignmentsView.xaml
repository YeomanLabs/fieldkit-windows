<?xml version="1.0" encoding="utf-8"?>
<!-- A device's or person's groups and what Intune targets through them. Hosted by the device page's tab and AssignmentsPage. -->
<UserControl
    x:Class="FieldKit.App.Views.AssignmentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:domain="using:FieldKit.Core.Domain"
    xmlns:local="using:FieldKit.App.Views"
    xmlns:vm="using:FieldKit.Core.ViewModels"
    IsTabStop="False">

    <StackPanel Spacing="16">
        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Explanation, Mode=OneWay}" />

        <controls:SectionCard
            Header="{x:Bind ViewModel.DeviceGroups.Header, Mode=OneWay}"
            NotFoundText="{x:Bind ViewModel.DeviceGroups.NotFoundText, Mode=OneWay}"
            RetryCommand="{x:Bind ViewModel.LoadCommand, Mode=OneWay}"
            State="{x:Bind ViewModel.DeviceGroups.State, Mode=OneWay}"
            Visibility="{x:Bind local:Ui.Visible(ViewModel.HasDeviceGroups), Mode=OneWay}">
            <ListView
                Margin="-12,0"
                AutomationProperties.Name="Device groups"
                IsItemClickEnabled="True"
                ItemClick="Group_ItemClick"
                ItemContainerStyle="{StaticResource NavigableListItemStyle}"
                ItemsSource="{x:Bind ViewModel.DeviceGroups.Groups, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="domain:DirectoryGroup">
                        <controls:GroupRow Group="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </controls:SectionCard>

        <controls:SectionCard
            Header="{x:Bind ViewModel.UserGroups.Header, Mode=OneWay}"
            NotFoundText="{x:Bind ViewModel.UserGroups.NotFoundText, Mode=OneWay}"
            RetryCommand="{x:Bind ViewModel.LoadCommand, Mode=OneWay}"
            State="{x:Bind ViewModel.UserGroups.State, Mode=OneWay}"
            Visibility="{x:Bind local:Ui.Visible(ViewModel.HasUserGroups), Mode=OneWay}">
            <ListView
                Margin="-12,0"
                AutomationProperties.Name="User groups"
                IsItemClickEnabled="True"
                ItemClick="Group_ItemClick"
                ItemContainerStyle="{StaticResource NavigableListItemStyle}"
                ItemsSource="{x:Bind ViewModel.UserGroups.Groups, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="domain:DirectoryGroup">
                        <controls:GroupRow Group="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </controls:SectionCard>

        <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="16" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AssignmentKindSection">
                    <controls:SectionCard
                        Header="{x:Bind Title}"
                        Note="{x:Bind Note, Mode=OneWay}"
                        NotFoundText="{x:Bind NotFoundText}"
                        RetryCommand="{x:Bind RetryCommand}"
                        State="{x:Bind State, Mode=OneWay}">
                        <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Items, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="domain:ResolvedAssignment">
                                    <controls:AssignmentRow Assignment="{x:Bind}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SectionCard>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
