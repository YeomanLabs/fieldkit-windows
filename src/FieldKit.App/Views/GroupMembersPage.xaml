<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FieldKit.App.Views.GroupMembersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:domain="using:FieldKit.Core.Domain"
    xmlns:local="using:FieldKit.App.Views"
    Background="Transparent">

    <Page.Resources>
        <MenuFlyout x:Key="MemberMenu">
            <MenuFlyoutItem Click="Remove_Click" Text="Remove from group…">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE738;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="36,20,24,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleStyle}" Text="Members" />
                <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Group.DisplayName, Mode=OneWay}" />
            </StackPanel>
            <CommandBar Grid.Column="1" VerticalAlignment="Center" Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton Command="{x:Bind ViewModel.LoadCommand, Mode=OneWay}" Label="Refresh" ToolTipService.ToolTip="Refresh (F5)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <Grid Padding="36,8,36,36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="900" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="16">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                        Severity="{x:Bind local:Ui.NoticeSeverity(ViewModel.NoticeIsError), Mode=OneWay}" />

                    <controls:SectionCard
                        Header="Direct members"
                        NotFoundText="This group has no members."
                        RetryCommand="{x:Bind ViewModel.LoadCommand, Mode=OneWay}"
                        State="{x:Bind ViewModel.Members, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <ListView
                                x:Name="MemberList"
                                Margin="-12,0"
                                AutomationProperties.Name="Members"
                                ContextRequested="MemberList_ContextRequested"
                                IsItemClickEnabled="True"
                                ItemClick="Member_ItemClick"
                                ItemContainerStyle="{StaticResource NavigableListItemStyle}"
                                ItemsSource="{x:Bind ViewModel.MemberList, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="domain:GroupMember">
                                        <controls:MemberRow Member="{x:Bind}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind ViewModel.Footer, Mode=OneWay}" />
                        </StackPanel>
                    </controls:SectionCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
