<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FieldKit.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:local="using:FieldKit.App.Views"
    xmlns:vm="using:FieldKit.Core.ViewModels"
    Background="Transparent">

    <ScrollViewer>
        <!-- Cards fill the page up to 900 wide, left-aligned. -->
        <Grid Padding="{StaticResource PagePadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="900" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel Spacing="16">
            <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleStyle}" Text="Settings" />

            <!-- Account -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind local:Ui.Visible(ViewModel.Session.IsSignedIn)}">
                <StackPanel Spacing="10">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Account" />
                    <controls:DetailRow Label="Name" Value="{x:Bind ViewModel.Session.User.DisplayName}" />
                    <controls:DetailRow Label="Username" Value="{x:Bind ViewModel.Session.User.Username}" />
                    <controls:DetailRow Label="Tenant" Value="{x:Bind ViewModel.TenantText}" />
                    <Button Margin="0,4,0,0" Click="SignOut_Click" Content="Sign out…" />
                </StackPanel>
            </Border>

            <!-- Tenant setup -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Tenant setup" />
                    <controls:DetailRow Label="Tenant ID" Value="{x:Bind ViewModel.TenantId}" Visibility="{x:Bind local:Ui.Visible(ViewModel.HasConfig)}" />
                    <controls:DetailRow Label="Client ID" Value="{x:Bind ViewModel.ClientId}" Visibility="{x:Bind local:Ui.Visible(ViewModel.HasConfig)}" />
                    <controls:DetailRow Label="Tenant" Value="Demo data" Visibility="{x:Bind local:Ui.Visible(ViewModel.Session.IsDemo)}" />
                    <Button Margin="0,4,0,0" Click="ChangeSetup_Click" Content="Change tenant setup…" />
                </StackPanel>
            </Border>

            <!-- Permissions: what the current token carries. -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind local:Ui.Visible(ViewModel.HasPermissions)}">
                <StackPanel Spacing="10">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Permissions" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="What your current sign-in can ask Microsoft Graph for. After an admin grants a permission, select Refresh sign-in. Your own Intune and Entra roles still decide what you can actually do." />
                    <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind local:Ui.PermissionsLoading(ViewModel.Permissions.State), Mode=OneWay}">
                        <ProgressRing Width="16" Height="16" IsActive="True" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Checking…" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="Microsoft didn't say which permissions this sign-in has. Features that are missing one will say so when you use them."
                        Visibility="{x:Bind local:Ui.PermissionsUnknown(ViewModel.Permissions.State), Mode=OneWay}" />
                    <controls:ToneText
                        Text="{x:Bind ViewModel.Permissions.Message, Mode=OneWay}"
                        Tone="Caution"
                        Visibility="{x:Bind local:Ui.PermissionsFailed(ViewModel.Permissions.State), Mode=OneWay}" />
                    <ItemsControl
                        IsTabStop="False"
                        ItemsSource="{x:Bind ViewModel.Permissions.Rows, Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.PermissionsLoaded(ViewModel.Permissions.State), Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PermissionRow">
                                <Grid Padding="0,6" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Permission.Purpose}" />
                                        <TextBlock FontFamily="{StaticResource MonospaceFont}" Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind Permission.Name}" />
                                    </StackPanel>
                                    <controls:ToneText
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        IsSelectable="False"
                                        Text="{x:Bind Status}"
                                        Tone="{x:Bind local:Ui.PermissionTone(IsGranted, IsMissing)}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{x:Bind ViewModel.Permissions.RefreshCommand}" Content="Refresh sign-in" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind local:Ui.Refreshed(ViewModel.Permissions.State, ViewModel.Permissions.RefreshedAt), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Appearance" />
                    <RadioButtons AutomationProperties.Name="Theme" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <x:String>Use my Windows setting</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- Audit rules -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Audit rules" />
                    <NumberBox
                        MaxWidth="240"
                        HorizontalAlignment="Left"
                        Header="Stale after (days without a sync)"
                        LargeChange="7"
                        Maximum="365"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.StaleThresholdDays, Mode=TwoWay}" />
                    <TextBox
                        AutomationProperties.Name="Naming convention (regular expression)"
                        FontFamily="{StaticResource MonospaceFont}"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="Leave empty to skip the check"
                        Text="{x:Bind ViewModel.Settings.NamingConventionRegex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Header>
                            <TextBlock Style="{StaticResource FieldHeaderStyle}" Text="Naming convention (regular expression)" />
                        </TextBox.Header>
                    </TextBox>
                    <controls:ToneText
                        Text="{x:Bind ViewModel.RegexProblem, Mode=OneWay}"
                        Tone="Critical"
                        Visibility="{x:Bind local:Ui.Visible(ViewModel.HasRegexProblem), Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="The regex must match the whole Intune device name, ignoring case. Leave it empty to skip the check. Example: ^CTS-(LT|DT)-[0-9]{5}$" />
                </StackPanel>
            </Border>

            <!-- Local data -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Local data" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Deletes site walks, recent lookups and these settings from this PC. Tenant setup is kept. CSV files you exported, and anything in Intune or Entra, aren't touched." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Click="Clear_Click" Content="Clear all local data…" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ClearMessage, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="About" />
                    <controls:DetailRow Label="Version" Value="{x:Bind ViewModel.Version}" />
                    <controls:DetailRow Label="Data folder" Value="{x:Bind DataFolder}" />
                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="FieldKit keeps only settings, recent lookups and site walks on this PC. Sign-in tokens stay with Windows; nothing is sent anywhere except Microsoft sign-in and Microsoft Graph." />
                    <HyperlinkButton Margin="-12,0,0,0" Content="Updates and help" NavigateUri="https://github.com/YeomanLabs/fieldkit-windows" />
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
