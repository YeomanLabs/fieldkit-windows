<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FieldKit.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    PointerPressed="Page_PointerPressed">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Invoked="FocusDevices_Invoked" Key="L" Modifiers="Control" />
        <KeyboardAccelerator Invoked="FocusSearch_Invoked" Key="F" Modifiers="Control" />
        <KeyboardAccelerator Invoked="Back_Invoked" Key="Left" Modifiers="Menu" />
        <KeyboardAccelerator Invoked="Back_Invoked" Key="Escape" />
    </Page.KeyboardAccelerators>

    <NavigationView
        x:Name="Navigation"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="True"
        IsTitleBarAutoPaddingEnabled="False"
        ItemInvoked="Navigation_ItemInvoked"
        OpenPaneLength="260"
        PaneDisplayMode="Auto"
        SelectionChanged="Navigation_SelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="DevicesItem" Content="Devices" ToolTipService.ToolTip="Intune devices; scan or type a serial (Ctrl+L)">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7F8;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="UsersItem" Content="Users" ToolTipService.ToolTip="Users in your directory">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE716;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="GroupsItem" Content="Groups" ToolTipService.ToolTip="Groups in your directory">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE902;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="PreStageItem" Content="Pre-stage" ToolTipService.ToolTip="Tag Autopilot devices in a batch">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8EC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="SiteWalksItem" Content="Site walks" ToolTipService.ToolTip="Scan a room or floor and export a CSV">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE805;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="AccountItem" SelectsOnInvoked="False">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE77B;" />
                </NavigationViewItem.Icon>
                <StackPanel>
                    <TextBlock x:Name="AccountName" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AccountTenant" Style="{StaticResource CaptionSecondaryStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
    </NavigationView>
</Page>
