<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FieldKit.App.Views.RemediationPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:domain="using:FieldKit.Core.Domain"
    xmlns:local="using:FieldKit.App.Views"
    Title="Run remediation"
    CloseButtonText="Cancel"
    DefaultButton="Close">

    <StackPanel MinWidth="440" Spacing="12">
        <TextBox
            x:Name="SearchBox"
            AutomationProperties.Name="Remediation name"
            IsSpellCheckEnabled="False"
            PlaceholderText="Remediation name"
            Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <controls:SectionCard
            Header="Remediations"
            NotFoundText="No remediations in this tenant."
            RetryCommand="{x:Bind RetryCommand}"
            State="{x:Bind ViewModel.Scripts, Mode=OneWay}">
            <ListView
                MaxHeight="320"
                Margin="-12,0"
                AutomationProperties.Name="Remediations"
                IsItemClickEnabled="True"
                ItemClick="Script_ItemClick"
                ItemContainerStyle="{StaticResource NavigableListItemStyle}"
                ItemsSource="{x:Bind ViewModel.Filtered, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="domain:AssignedItem">
                        <StackPanel AutomationProperties.Name="{x:Bind Name}" Spacing="2">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Name}" />
                            <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind Detail}" Visibility="{x:Bind local:Ui.VisibleIfText(Detail)}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </controls:SectionCard>
        <TextBlock x:Name="Footer" Style="{StaticResource CaptionSecondaryStyle}" />
    </StackPanel>
</ContentDialog>
