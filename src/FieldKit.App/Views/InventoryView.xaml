<?xml version="1.0" encoding="utf-8"?>
<!-- Storage, hardware, battery, network, Defender and installed apps (ports DeviceInventoryView). -->
<UserControl
    x:Class="FieldKit.App.Views.InventoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:domain="using:FieldKit.Core.Domain"
    xmlns:local="using:FieldKit.App.Views"
    xmlns:vm="using:FieldKit.Core.ViewModels"
    IsTabStop="False">

    <UserControl.Resources>
        <DataTemplate x:Key="InfoRowTemplate" x:DataType="vm:InfoRow">
            <controls:DetailRow Margin="0,4" Label="{x:Bind Label}" Tone="{x:Bind local:Ui.InfoRowTone(Tone)}" Value="{x:Bind Value}" />
        </DataTemplate>

        <DataTemplate x:Key="InfoSectionTemplate" x:DataType="vm:InfoSection">
            <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="{x:Bind Title}" />
                    <ItemsControl IsTabStop="False" ItemTemplate="{StaticResource InfoRowTemplate}" ItemsSource="{x:Bind Rows}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Columns" ColumnSpacing="16" SizeChanged="Columns_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SecondColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="LeftColumn">
            <controls:SectionCard
                Margin="0,0,0,16"
                Header="Storage"
                RetryCommand="{x:Bind ViewModel.LoadCommand, Mode=OneWay}"
                State="{x:Bind ViewModel.Inventory, Mode=OneWay}">
                <StackPanel>
                    <controls:StorageBar Usage="{x:Bind ViewModel.Storage, Mode=OneWay}" Visibility="{x:Bind local:Ui.Visible(ViewModel.HasStorage), Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Intune hasn't reported storage for this device." Visibility="{x:Bind local:Ui.Visible(ViewModel.NoStorage), Mode=OneWay}" />
                </StackPanel>
            </controls:SectionCard>

            <ItemsControl IsTabStop="False" ItemTemplate="{StaticResource InfoSectionTemplate}" ItemsSource="{x:Bind ViewModel.InventorySections, Mode=OneWay}" />

            <controls:SectionCard
                Margin="0,0,0,16"
                Header="Hardware"
                RetryCommand="{x:Bind ViewModel.LoadCommand, Mode=OneWay}"
                State="{x:Bind ViewModel.Hardware, Mode=OneWay}">
                <ItemsControl IsTabStop="False" ItemTemplate="{StaticResource InfoRowTemplate}" ItemsSource="{x:Bind ViewModel.HardwareRows, Mode=OneWay}" />
            </controls:SectionCard>

            <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}" Visibility="{x:Bind local:Ui.Visible(ViewModel.HardwareLoaded), Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Battery" />
                    <ItemsControl IsTabStop="False" ItemTemplate="{StaticResource InfoRowTemplate}" ItemsSource="{x:Bind ViewModel.BatteryRows, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Intune doesn't report battery details for this device." Visibility="{x:Bind local:Ui.Visible(ViewModel.NoBattery), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <ItemsControl IsTabStop="False" ItemTemplate="{StaticResource InfoSectionTemplate}" ItemsSource="{x:Bind ViewModel.ConnectivitySections, Mode=OneWay}" />
        </StackPanel>

        <StackPanel x:Name="RightColumn" Grid.Column="1">
            <controls:SectionCard
                Margin="0,0,0,16"
                Header="Microsoft Defender"
                NotFoundText="Defender hasn't reported to Intune for this device."
                RetryCommand="{x:Bind ViewModel.LoadCommand, Mode=OneWay}"
                State="{x:Bind ViewModel.DefenderState, Mode=OneWay}"
                Visibility="{x:Bind local:Ui.Visible(ViewModel.IsWindows), Mode=OneWay}">
                <ItemsControl IsTabStop="False" ItemTemplate="{StaticResource InfoRowTemplate}" ItemsSource="{x:Bind ViewModel.DefenderRows, Mode=OneWay}" />
            </controls:SectionCard>

            <controls:SectionCard
                Margin="0,0,0,16"
                Header="{x:Bind ViewModel.AppsHeader, Mode=OneWay}"
                NotFoundText="Intune's inventory hasn't found any apps yet."
                RetryCommand="{x:Bind ViewModel.LoadCommand, Mode=OneWay}"
                State="{x:Bind ViewModel.Apps, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBox
                        AutomationProperties.Name="Filter apps by app or publisher"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="App or publisher"
                        Text="{x:Bind ViewModel.AppQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.FilteredApps, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="domain:DetectedApp">
                                <StackPanel Padding="0,5" Spacing="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontFamily="{StaticResource MonospaceFont}"
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource CaptionSecondaryStyle}"
                                            Text="{x:Bind Version}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind local:Ui.DetectedAppDetail(Id, Publisher, SizeBytes)}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind ViewModel.AppsFooter, Mode=OneWay}" />
                </StackPanel>
            </controls:SectionCard>
        </StackPanel>
    </Grid>
</UserControl>
