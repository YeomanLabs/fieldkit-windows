<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FieldKit.App.Views.AutopilotEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:domain="using:FieldKit.Core.Domain"
    xmlns:local="using:FieldKit.App.Views"
    Title="Edit Autopilot"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
    PrimaryButtonClick="Save_Click"
    PrimaryButtonText="Save">

    <StackPanel MinWidth="420" Spacing="18">
        <!-- Group tag -->
        <StackPanel Spacing="8">
            <TextBox
                x:Name="TagBox"
                AutomationProperties.Name="Group tag"
                IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsSaving), Mode=OneWay}"
                IsSpellCheckEnabled="False"
                PlaceholderText="No group tag"
                Text="{x:Bind ViewModel.GroupTagText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Header>
                    <TextBlock Style="{StaticResource FieldHeaderStyle}" Text="Group tag" />
                </TextBox.Header>
            </TextBox>
            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.SuggestedTags, Mode=OneWay}" Visibility="{x:Bind local:Ui.Visible(ViewModel.HasSuggestedTags), Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:FlowPanel Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Padding="10,2" Click="SuggestedTag_Click" Content="{x:Bind}" FontSize="12" Tag="{x:Bind}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="Leave empty to clear the tag. Dynamic groups and deployment profiles that use the tag update after Intune syncs." />
        </StackPanel>

        <!-- Assigned user -->
        <StackPanel Spacing="8">
            <controls:DetailRow Label="Assigned user" Value="{x:Bind ViewModel.AssignedUserText, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PickUserButton" Click="PickUser_Click" Content="{x:Bind ViewModel.ChangeUserText}" IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsSaving), Mode=OneWay}" />
                <Button
                    Click="ToggleRemove_Click"
                    Content="{x:Bind ViewModel.RemoveToggleText, Mode=OneWay}"
                    IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsSaving), Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Visible(ViewModel.ShowsRemoveToggle), Mode=OneWay}" />
            </StackPanel>

            <!-- The person picker opens in place: one dialog can't open another. -->
            <StackPanel x:Name="Picker" Spacing="8" Visibility="Collapsed">
                <TextBox
                    x:Name="PersonSearch"
                    AutomationProperties.Name="Find a person by name or email"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="Name or email"
                    TextChanged="PersonSearch_TextChanged" />
                <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="Search by name or email." Visibility="{x:Bind local:Ui.Collapsed(People.ShowsPeople), Mode=OneWay}" />
                <controls:SectionCard
                    Header="People"
                    NotFoundText="No people match."
                    RetryCommand="{x:Bind People.RetryCommand}"
                    State="{x:Bind People.People, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Visible(People.ShowsPeople), Mode=OneWay}">
                    <ListView
                        MaxHeight="220"
                        Margin="-12,0"
                        AutomationProperties.Name="People"
                        IsItemClickEnabled="True"
                        ItemClick="Person_ItemClick"
                        ItemContainerStyle="{StaticResource NavigableListItemStyle}"
                        ItemsSource="{x:Bind People.PeopleResults, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="domain:DirectoryUser">
                                <controls:PersonRow Person="{x:Bind}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </controls:SectionCard>
            </StackPanel>
            <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="The assigned user's name is shown on the device's sign-in page during setup." />
        </StackPanel>

        <StackPanel Spacing="8">
            <controls:DetailRow Label="Serial" Value="{x:Bind ViewModel.SerialNumber}" />
            <controls:DetailRow Label="Model" Value="{x:Bind ViewModel.ModelText}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind local:Ui.Visible(ViewModel.IsSaving), Mode=OneWay}">
            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Saving…" />
        </StackPanel>
        <controls:ToneText Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Tone="Caution" Visibility="{x:Bind local:Ui.Visible(ViewModel.HasError), Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
