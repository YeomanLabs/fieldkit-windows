<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FieldKit.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:domain="using:FieldKit.Core.Domain"
    xmlns:local="using:FieldKit.App.Views"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Invoked="Refresh_Invoked" Key="F5" />
    </Page.KeyboardAccelerators>

    <Grid MaxWidth="960" Padding="36,24,36,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="16">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind Home.IsDemo, Mode=OneWay}"
                Visibility="{x:Bind local:Ui.Visible(Home.IsDemo), Mode=OneWay}"
                Message="Sample devices, people and groups. Nothing connects to Microsoft or changes anything. To use your own tenant: Settings → Change tenant setup."
                Severity="Informational"
                Title="Demo data">
                <InfoBar.Content>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Try:" />
                        <ItemsControl x:Name="DemoSerials" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind Home.HasActiveWalk, Mode=OneWay}"
                Visibility="{x:Bind local:Ui.Visible(Home.HasActiveWalk), Mode=OneWay}"
                Message="{x:Bind Home.ActiveWalkText, Mode=OneWay}"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button Click="ResumeWalk_Click" Content="Resume" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind Home.StorageIsTemporary}"
                Visibility="{x:Bind local:Ui.Visible(Home.StorageIsTemporary)}"
                Message="Recent lookups and settings won't be kept after FieldKit closes."
                Severity="Warning"
                Title="Local storage couldn't be opened" />

            <StackPanel Spacing="4">
                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleStyle}" Text="Devices" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Home.UserLine, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SearchBox"
                        AutomationProperties.Name="Search devices or scan a serial"
                        FontSize="18"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        KeyDown="SearchBox_KeyDown"
                        PlaceholderText="Device name or serial"
                        Text="{x:Bind Devices.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Header>
                            <TextBlock Style="{StaticResource FieldHeaderStyle}" Text="Search or scan" />
                        </TextBox.Header>
                    </TextBox>
                    <Button
                        Grid.Column="1"
                        MinHeight="40"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="{x:Bind Home.ThisPcAutomationName}"
                        Click="ThisPc_Click"
                        ToolTipService.ToolTip="{x:Bind Home.ThisPcDetail}"
                        Visibility="{x:Bind local:Ui.Visible(Home.HasThisPc)}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE7F8;" />
                            <TextBlock Text="This PC" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Devices.EnterError, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind local:Ui.Visible(Devices.HasEnterError), Mode=OneWay}" />
                <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="Type the start of a name to filter. Scan or paste a serial and press Enter to open it; USB and Bluetooth scanners work here. Ctrl+L comes back to this box." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:Ui.Visible(Home.HasRecents), Mode=OneWay}">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Recent:" />
                <ItemsControl x:Name="RecentList" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind Devices.Heading, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <ProgressRing
                Grid.Column="1"
                Width="16"
                Height="16"
                IsActive="{x:Bind Devices.IsBusy, Mode=OneWay}" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Refresh devices"
                Command="{x:Bind Devices.RefreshCommand}"
                ToolTipService.ToolTip="Refresh (F5)">
                <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <ListView
            x:Name="DeviceList"
            Grid.Row="2"
            Margin="-12,0"
            AutomationProperties.Name="Devices"
            IsItemClickEnabled="True"
            ItemClick="Device_ItemClick"
            ItemContainerStyle="{StaticResource NavigableListItemStyle}"
            ItemsSource="{x:Bind Devices.Items}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="domain:IntuneDevice">
                    <controls:DeviceRow Device="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <StackPanel Padding="12,8,12,24" Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Devices.LoadMoreError, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:Ui.Visible(Devices.HasLoadMoreError), Mode=OneWay}" />
                    <Button
                        Command="{x:Bind Devices.LoadMoreCommand}"
                        Content="Load more devices"
                        Visibility="{x:Bind local:Ui.Visible(Devices.CanLoadMore), Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind local:Ui.Visible(Devices.IsLoadingMore), Mode=OneWay}">
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind Devices.IsLoadingMore, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Loading more…" />
                    </StackPanel>
                </StackPanel>
            </ListView.Footer>
        </ListView>

        <controls:ListStatus
            Grid.Row="2"
            VerticalAlignment="Top"
            NotFoundText="{x:Bind Devices.NotFoundText, Mode=OneWay}"
            RetryCommand="{x:Bind Devices.RefreshCommand}"
            State="{x:Bind Devices.State, Mode=OneWay}"
            Subject="devices" />
    </Grid>
</Page>
