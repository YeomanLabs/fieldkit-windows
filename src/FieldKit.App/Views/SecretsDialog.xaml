<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FieldKit.App.Views.SecretsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:local="using:FieldKit.App.Views"
    xmlns:vm="using:FieldKit.Core.ViewModels"
    Title="{x:Bind ViewModel.Title}"
    CloseButtonText="Done"
    DefaultButton="Close">

    <StackPanel MinWidth="440" Spacing="16">
        <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Sections}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="16" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SecretSection">
                    <StackPanel Spacing="8">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource CardHeaderStyle}"
                            Text="{x:Bind Header}"
                            Visibility="{x:Bind local:Ui.Visible(HasHeader)}" />
                        <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SecretDetail">
                                    <controls:DetailRow Margin="0,2" Label="{x:Bind Label}" Value="{x:Bind Value}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Secrets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SecretValue">
                                    <StackPanel Margin="0,4" Spacing="8">
                                        <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind Label}" />
                                        <TextBlock
                                            AutomationProperties.Name="{x:Bind AutomationText, Mode=OneWay}"
                                            FontFamily="{StaticResource MonospaceFont}"
                                            FontSize="20"
                                            IsTextSelectionEnabled="False"
                                            Text="{x:Bind DisplayText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                AutomationProperties.Name="{x:Bind ToggleText, Mode=OneWay}"
                                                Click="Toggle_Click"
                                                Content="{x:Bind ToggleText, Mode=OneWay}"
                                                Tag="{x:Bind}" />
                                            <Button
                                                AutomationProperties.Name="{x:Bind CopyText, Mode=OneWay}"
                                                Click="Copy_Click"
                                                Content="{x:Bind CopyText, Mode=OneWay}"
                                                Tag="{x:Bind}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind Footer}" Visibility="{x:Bind local:Ui.Visible(HasFooter)}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind ViewModel.Note}" />
    </StackPanel>
</ContentDialog>
