<?xml version="1.0" encoding="utf-8"?>
<!-- A site walk's summary and CSV export (ports SiteWalkSummaryView). -->
<Page
    x:Class="FieldKit.App.Views.SiteWalkSummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:local="using:FieldKit.App.Views"
    xmlns:vm="using:FieldKit.Core.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="InfoRowTemplate" x:DataType="vm:InfoRow">
            <controls:DetailRow Margin="0,4" Label="{x:Bind Label}" Tone="{x:Bind local:Ui.InfoRowTone(Tone)}" Value="{x:Bind Value}" />
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="36,24,36,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="900" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleStyle}" Text="Site walk summary" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Walk.Site}" />
                </StackPanel>

                <Border Style="{StaticResource CardStyle}">
                    <ItemsControl IsTabStop="False" ItemTemplate="{StaticResource InfoRowTemplate}" ItemsSource="{x:Bind ViewModel.Details}" />
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Flags" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:Ui.Visible(ViewModel.NoFlags)}">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE930;" />
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="No flags" />
                        </StackPanel>
                        <ItemsControl IsTabStop="False" ItemTemplate="{StaticResource InfoRowTemplate}" ItemsSource="{x:Bind ViewModel.FlagCounts}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Export" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="A CSV with one row per device, as it was when scanned. It opens cleanly in Excel." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.Name="Export CSV…" Click="Export_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE74E;" />
                                    <TextBlock Text="Export CSV…" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenButton" Click="Open_Click" Content="Open file" Visibility="Collapsed" />
                        </StackPanel>
                        <controls:ToneText x:Name="ExportStatus" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
