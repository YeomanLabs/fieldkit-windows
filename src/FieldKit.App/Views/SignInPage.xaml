<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FieldKit.App.Views.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FieldKit.App.Views"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel
            MaxWidth="420"
            Padding="24,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="20">
            <Image
                Width="96"
                Height="96"
                AutomationProperties.AccessibilityView="Raw"
                Source="ms-appx:///Assets/AppIcon-256.png" />
            <StackPanel Spacing="8">
                <TextBlock
                    HorizontalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    Text="FieldKit" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="Look up, fix and pre-stage devices in Intune, Entra and Autopilot."
                    TextAlignment="Center" />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="Error" />

            <Button
                x:Name="SignInButton"
                MinHeight="44"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{x:Bind ViewModel.ButtonText, Mode=OneWay}"
                Command="{x:Bind ViewModel.SignInCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        IsActive="{x:Bind ViewModel.IsSigningIn, Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.Visible(ViewModel.IsSigningIn), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ButtonText, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <HyperlinkButton
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.ChangeSetupCommand}"
                Content="{x:Bind ViewModel.SetupLinkText, Mode=OneWay}"
                IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsSigningIn), Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
