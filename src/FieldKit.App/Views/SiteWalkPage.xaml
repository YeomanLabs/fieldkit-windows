<?xml version="1.0" encoding="utf-8"?>
<!-- An active site walk: scan (or paste) device after device; each is looked up and flagged. -->
<Page
    x:Class="FieldKit.App.Views.SiteWalkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:local="using:FieldKit.App.Views"
    xmlns:vm="using:FieldKit.Core.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <MenuFlyout x:Key="ScanMenu">
            <MenuFlyoutItem x:Name="RetryItem" Click="RetryScan_Click" Text="Retry lookup">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE72C;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="DeleteScan_Click" Text="Delete">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="36,20,24,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleStyle}" Text="Site walk" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Heading}" />
            </StackPanel>
            <CommandBar Grid.Column="1" VerticalAlignment="Center" Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton Click="Summary_Click" Label="Summary">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="End_Click" Label="End…">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE73E;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <Grid Padding="36,8,36,36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="900" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <controls:SerialEntryBox
                                x:Name="Entry"
                                ListPasted="Entry_ListPasted"
                                PasteListDescription="Each serial is looked up in order, as if it had been scanned."
                                SerialSubmitted="Entry_SerialSubmitted"
                                SubmitText="Add" />
                            <controls:ToneText
                                x:Name="Banner"
                                Text="{x:Bind ViewModel.BannerText, Mode=OneWay}"
                                Tone="{x:Bind local:Ui.BannerTone(ViewModel.BannerIsWarning), Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Visible(ViewModel.HasBanner), Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="USB and Bluetooth barcode scanners work here: scan each device's label and the box is ready for the next one." />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8" Visibility="{x:Bind local:Ui.Visible(ViewModel.HasScans), Mode=OneWay}">
                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="{x:Bind ViewModel.ScannedHeader, Mode=OneWay}" />
                        <ListView
                            x:Name="ScanList"
                            Margin="-12,0"
                            AutomationProperties.Name="Scanned devices"
                            ContextRequested="ScanList_ContextRequested"
                            IsItemClickEnabled="True"
                            ItemClick="Scan_ItemClick"
                            ItemContainerStyle="{StaticResource NavigableListItemStyle}"
                            ItemsSource="{x:Bind ViewModel.Scans}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScanItem">
                                    <Grid AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
                                            <TextBlock
                                                FontFamily="{StaticResource MonospaceFont}"
                                                Style="{StaticResource CaptionSecondaryStyle}"
                                                Text="{x:Bind Serial}"
                                                Visibility="{x:Bind local:Ui.Visible(HasName), Mode=OneWay}" />
                                            <controls:ToneText Text="{x:Bind FailureText, Mode=OneWay}" Tone="Caution" Visibility="{x:Bind local:Ui.Visible(IsFailed), Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                            <ProgressRing Width="18" Height="18" IsActive="{x:Bind IsPending, Mode=OneWay}" Visibility="{x:Bind local:Ui.Visible(IsPending), Mode=OneWay}" />
                                            <FontIcon
                                                FontSize="16"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Glyph="&#xE72C;"
                                                ToolTipService.ToolTip="Lookup failed: right-click to retry"
                                                Visibility="{x:Bind local:Ui.Visible(IsFailed), Mode=OneWay}" />
                                            <FontIcon
                                                FontSize="16"
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                Glyph="&#xE930;"
                                                Visibility="{x:Bind local:Ui.Visible(NoFlags), Mode=OneWay}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind local:Ui.Visible(HasFlags), Mode=OneWay}">
                                                <controls:ToneText Text="{x:Bind FlagCountText, Mode=OneWay}" Tone="{x:Bind local:Ui.SeverityTone(SeverityTitle), Mode=OneWay}" />
                                                <controls:ToneText Text="{x:Bind SeverityTitle, Mode=OneWay}" Tone="{x:Bind local:Ui.SeverityTone(SeverityTitle), Mode=OneWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="Select a device to open it. Right-click (or the menu key) to retry a failed lookup or delete a scan." />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
