<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FieldKit.App.Views.PersonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:domain="using:FieldKit.Core.Domain"
    xmlns:local="using:FieldKit.App.Views"
    xmlns:vm="using:FieldKit.Core.ViewModels"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="36,20,24,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource PageTitleStyle}"
                    Text="{x:Bind ViewModel.Person.DisplayName, Mode=OneWay}" />
                <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Person.UserPrincipalName, Mode=OneWay}" />
            </StackPanel>
            <CommandBar Grid.Column="1" VerticalAlignment="Center" Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton Command="{x:Bind ViewModel.LoadCommand, Mode=OneWay}" Label="Refresh" ToolTipService.ToolTip="Refresh (F5)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <!-- Cards fill the page up to 900 wide, left-aligned. -->
            <Grid Padding="36,8,36,36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="900" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            <StackPanel Spacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <controls:DetailRow Label="Name" Value="{x:Bind ViewModel.Person.DisplayName, Mode=OneWay}" />
                        <controls:DetailRow Label="UPN" Value="{x:Bind ViewModel.Person.UserPrincipalName, Mode=OneWay}" />
                        <controls:DetailRow Label="Email" Value="{x:Bind ViewModel.Person.Mail, Mode=OneWay}" Visibility="{x:Bind local:Ui.Visible(ViewModel.ShowsEmail), Mode=OneWay}" />
                        <controls:DetailRow Label="Job title" Value="{x:Bind ViewModel.Person.JobTitle, Mode=OneWay}" Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.Person.JobTitle), Mode=OneWay}" />
                        <controls:DetailRow Label="Department" Value="{x:Bind ViewModel.Person.Department, Mode=OneWay}" Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.Person.Department), Mode=OneWay}" />
                        <HyperlinkButton Margin="-12,0,0,0" Click="Assignments_Click" Content="Groups and assignments" />
                    </StackPanel>
                </Border>

                <!-- Why was I blocked? (Windows only) -->
                <controls:SectionCard
                    Header="Sign-ins"
                    NotFoundText="No interactive sign-ins in the last 7 days."
                    RetryCommand="{x:Bind ViewModel.LoadSignInsCommand, Mode=OneWay}"
                    State="{x:Bind ViewModel.SignIns, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.SignInSummary, Mode=OneWay}" />
                            <ToggleSwitch
                                Grid.Column="1"
                                MinWidth="0"
                                AutomationProperties.Name="Show only problems"
                                IsOn="{x:Bind ViewModel.OnlyProblems, Mode=TwoWay}"
                                OffContent="All sign-ins"
                                OnContent="Problems only" />
                        </Grid>
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="Nothing failed, was blocked or was interrupted. Switch to All sign-ins to see them."
                            Visibility="{x:Bind local:Ui.Visible(ViewModel.ShowsNoProblems), Mode=OneWay}" />
                        <ListView
                            Margin="-12,0"
                            AutomationProperties.Name="Sign-ins"
                            IsItemClickEnabled="True"
                            ItemClick="SignIn_ItemClick"
                            ItemContainerStyle="{StaticResource NavigableListItemStyle}"
                            ItemsSource="{x:Bind ViewModel.SignInList, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SignInItem">
                                    <Grid AutomationProperties.Name="{x:Bind AutomationName}" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:ToneText
                                            Margin="0,1,0,0"
                                            VerticalAlignment="Top"
                                            IsSelectable="False"
                                            Text="{x:Bind Label}"
                                            Tone="{x:Bind local:Ui.VerdictTone(Verdict)}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind App}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind Reason}" Visibility="{x:Bind local:Ui.VisibleIfText(Reason)}" />
                                            <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind Subtitle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </controls:SectionCard>

                <controls:SectionCard
                    Header="Primary user of"
                    NotFoundText="Not the primary user of any Intune device."
                    RetryCommand="{x:Bind ViewModel.LoadCommand, Mode=OneWay}"
                    State="{x:Bind ViewModel.Devices, Mode=OneWay}">
                    <ListView
                        Margin="-12,0"
                        AutomationProperties.Name="Devices"
                        IsItemClickEnabled="True"
                        ItemClick="Device_ItemClick"
                        ItemContainerStyle="{StaticResource NavigableListItemStyle}"
                        ItemsSource="{x:Bind ViewModel.DeviceList, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="domain:IntuneDevice">
                                <controls:DeviceRow Device="{x:Bind}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </controls:SectionCard>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
