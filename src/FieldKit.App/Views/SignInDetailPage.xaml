<?xml version="1.0" encoding="utf-8"?>
<!-- "Why was I blocked?": one sign-in explained (Windows only; the iOS roadmap's phase 4). -->
<Page
    x:Class="FieldKit.App.Views.SignInDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:local="using:FieldKit.App.Views"
    xmlns:vm="using:FieldKit.Core.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="InfoRowTemplate" x:DataType="vm:InfoRow">
            <controls:DetailRow Margin="0,4" Label="{x:Bind Label}" Tone="{x:Bind local:Ui.InfoRowTone(Tone)}" Value="{x:Bind Value}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Padding="36,20,24,8" Spacing="2">
            <controls:ToneText IsSelectable="False" Text="{x:Bind ViewModel.Diagnosis.Label, Mode=OneWay}" Tone="{x:Bind local:Ui.VerdictTone(ViewModel.Verdict), Mode=OneWay}" />
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PageTitleStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <Grid Padding="36,8,36,36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="900" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="16">
                    <!-- Why, and what to check -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Why" />
                            <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.Explanation, Mode=OneWay}" TextWrapping="Wrap" />
                            <StackPanel Spacing="6" Visibility="{x:Bind local:Ui.Visible(ViewModel.HasChecks), Mode=OneWay}">
                                <TextBlock Margin="0,6,0,0" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="What to check" />
                                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.WhatToCheck, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid Margin="0,2" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock AutomationProperties.AccessibilityView="Raw" Style="{StaticResource SecondaryTextStyle}" Text="•" />
                                                <TextBlock Grid.Column="1" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Conditional Access -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Conditional Access" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind ViewModel.PoliciesHiddenMessage, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Collapsed(ViewModel.PoliciesVisible), Mode=OneWay}" />
                            <StackPanel Spacing="8" Visibility="{x:Bind local:Ui.Visible(ViewModel.PoliciesVisible), Mode=OneWay}">
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind ViewModel.NoPoliciesText, Mode=OneWay}"
                                    Visibility="{x:Bind local:Ui.Collapsed(ViewModel.HasPolicies), Mode=OneWay}" />
                                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.PolicyList, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SignInPolicyItem">
                                            <Grid Padding="0,6" AutomationProperties.Name="{x:Bind AutomationName}" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind ControlsText}" Visibility="{x:Bind local:Ui.Visible(HasControls)}" />
                                                </StackPanel>
                                                <controls:ToneText
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    IsSelectable="False"
                                                    Text="{x:Bind ResultText}"
                                                    Tone="{x:Bind local:Ui.InfoRowTone(Tone)}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <HyperlinkButton
                                    Margin="-12,0,0,0"
                                    Click="ShowAllPolicies_Click"
                                    Content="{x:Bind ViewModel.ShowAllText, Mode=OneWay}"
                                    Visibility="{x:Bind local:Ui.Visible(ViewModel.HasPoliciesThatDidNotApply), Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Device -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Device" />
                            <ItemsControl IsTabStop="False" ItemTemplate="{StaticResource InfoRowTemplate}" ItemsSource="{x:Bind ViewModel.DeviceRows, Mode=OneWay}" />
                            <HyperlinkButton
                                Margin="-12,0,0,0"
                                Click="OpenDevice_Click"
                                Content="{x:Bind ViewModel.OpenDeviceText, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Visible(ViewModel.CanOpenDevice), Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Sign-in details -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Sign-in details" />
                            <ItemsControl IsTabStop="False" ItemTemplate="{StaticResource InfoRowTemplate}" ItemsSource="{x:Bind ViewModel.DetailRows, Mode=OneWay}" />
                            <controls:CopyableValue Margin="0,6,0,0" Label="Request ID" Value="{x:Bind ViewModel.RequestId, Mode=OneWay}" />
                            <controls:CopyableValue Label="Correlation ID" Value="{x:Bind ViewModel.CorrelationId, Mode=OneWay}" Visibility="{x:Bind local:Ui.Visible(ViewModel.HasCorrelationId), Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
