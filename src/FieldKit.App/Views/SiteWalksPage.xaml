<?xml version="1.0" encoding="utf-8"?>
<!-- Site walks: resume the one in progress, start one, and past walks. -->
<Page
    x:Class="FieldKit.App.Views.SiteWalksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FieldKit.App.Views"
    xmlns:vm="using:FieldKit.Core.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <MenuFlyout x:Key="WalkMenu">
            <MenuFlyoutItem Click="DeleteWalk_Click" Text="Delete…">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="36,24,36,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="900" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleStyle}" Text="Site walks" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Scan every device in a room or floor, see what needs attention, and export it as a CSV." />
                </StackPanel>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.StorageIsTemporary}"
                    Message="Local storage couldn't be opened. Site walks won't be saved."
                    Severity="Warning" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasActiveWalk, Mode=OneWay}"
                    Message="A site walk is in progress."
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button Click="Resume_Click" Content="{x:Bind ViewModel.ResumeText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Start (ports StartSiteWalkSheet). -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeaderStyle}" Text="Start a site walk" />
                        <TextBox
                            x:Name="SiteBox"
                            AutomationProperties.Name="Site"
                            KeyDown="Field_KeyDown"
                            PlaceholderText="Site"
                            Text="{x:Bind ViewModel.SiteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Header>
                                <TextBlock Style="{StaticResource FieldHeaderStyle}" Text="Site" />
                            </TextBox.Header>
                        </TextBox>
                        <TextBox
                            AutomationProperties.Name="Area or floor (optional)"
                            KeyDown="Field_KeyDown"
                            PlaceholderText="Area or floor (optional)"
                            Text="{x:Bind ViewModel.AreaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Header>
                                <TextBlock Style="{StaticResource FieldHeaderStyle}" Text="Area or floor (optional)" />
                            </TextBox.Header>
                        </TextBox>
                        <Button Click="Start_Click" Content="Start" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="The site is remembered for your next walk." />
                    </StackPanel>
                </Border>

                <!-- History (ports SiteWalkHistoryView). -->
                <StackPanel Spacing="8">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" Text="Past site walks" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="No site walks yet." Visibility="{x:Bind local:Ui.Visible(ViewModel.NoWalks), Mode=OneWay}" />
                    <ListView
                        x:Name="WalkList"
                        Margin="-12,0"
                        AutomationProperties.Name="Past site walks"
                        ContextRequested="WalkList_ContextRequested"
                        IsItemClickEnabled="True"
                        ItemClick="Walk_ItemClick"
                        ItemContainerStyle="{StaticResource NavigableListItemStyle}"
                        ItemsSource="{x:Bind ViewModel.Walks, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SiteWalkItem">
                                <StackPanel AutomationProperties.Name="{x:Bind AutomationName}" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Site}" />
                                        <Border Style="{StaticResource IntentChipStyle}" Visibility="{x:Bind local:Ui.Visible(IsActive)}">
                                            <TextBlock Style="{StaticResource IntentChipTextStyle}" Text="In progress" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind Subtitle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
