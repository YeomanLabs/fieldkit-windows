<?xml version="1.0" encoding="utf-8"?>
<!-- The device page's install status tab: did it actually install? (Windows only, 2026-10-14) -->
<UserControl
    x:Class="FieldKit.App.Views.InstallStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FieldKit.App.Controls"
    xmlns:local="using:FieldKit.App.Views"
    xmlns:vm="using:FieldKit.Core.ViewModels"
    IsTabStop="False">

    <StackPanel Spacing="16">
        <TextBlock
            Style="{StaticResource SecondaryTextStyle}"
            Text="What the device reported back to Intune: whether each app installed, and how each configuration profile or policy applied. After a change, Intune can take a while to catch up; Sync the device to hurry it along." />

        <controls:SectionCard
            Header="Apps"
            NotFoundText="No apps are assigned to this device or its primary user."
            RetryCommand="{x:Bind ViewModel.LoadCommand, Mode=OneWay}"
            State="{x:Bind ViewModel.Apps, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.AppSummary, Mode=OneWay}" />
                <controls:ToneText Text="{x:Bind ViewModel.FailureNote, Mode=OneWay}" Tone="Caution" Visibility="{x:Bind local:Ui.Visible(ViewModel.HasFailureNote), Mode=OneWay}" />
                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.AppList, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppStatusItem">
                            <Grid Padding="0,7" AutomationProperties.Name="{x:Bind AutomationName}" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind Subtitle}" />
                                    <controls:ToneText Text="{x:Bind ErrorText}" Tone="Critical" Visibility="{x:Bind local:Ui.Visible(HasError)}" />
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource CaptionSecondaryStyle}"
                                        Text="{x:Bind Detail}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind local:Ui.Visible(HasDetail)}" />
                                </StackPanel>
                                <controls:ToneText
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    IsSelectable="False"
                                    Text="{x:Bind StateText}"
                                    Tone="{x:Bind local:Ui.InfoRowTone(Tone)}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </controls:SectionCard>

        <controls:SectionCard
            Header="Configuration"
            NotFoundText="No configuration profiles or policies have reported for this device."
            RetryCommand="{x:Bind ViewModel.LoadCommand, Mode=OneWay}"
            State="{x:Bind ViewModel.Configuration, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ConfigurationSummary, Mode=OneWay}" />
                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.ConfigurationList, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PolicyStatusItem">
                            <Grid Padding="0,7" AutomationProperties.Name="{x:Bind AutomationName}" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind Subtitle}" />
                                </StackPanel>
                                <controls:ToneText
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    IsSelectable="False"
                                    Text="{x:Bind StateText}"
                                    Tone="{x:Bind local:Ui.InfoRowTone(Tone)}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </controls:SectionCard>
    </StackPanel>
</UserControl>
